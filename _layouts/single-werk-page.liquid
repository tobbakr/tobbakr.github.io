---
layout: single-page
image: assets/img/social_schrijnwerkerijtobback.png
---
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "{{ page.header | escape }}",
    "description": "{{ page.description | escape }}",
    "image": "{{ site.url }}/{{ page.img }}",
    "dateCreated": "{{ page.date | date: '%Y-%m-%d' }}",
    "creator": {
      "@type": "Organization",
      "name": "Schrijnwerkerij Tobback",
      "url": "https://schrijnwerkerijtobback.be"
    },
    "locationCreated": {
      "@type": "Place",
      "name": "{{ page.location }}"
    }
  }
</script>

<section class="werk-detail">
  <div class="container">
    <div class="row align-items-start">
      <div class="col-md-5 mb-4">
        <div class="werk-detail-img">
          {%
            include figure.liquid path=page.img alt=page.title width=page.img_w height=page.img_h
            loading="eager"
          %}
        </div>
      </div>
      <div class="col-md-7">
        <h2 class="werk-detail-title">{{ page.header }}</h2>
        {% if page.subheader %}
          <p class="werk-detail-sub">{{ page.subheader }}</p>
        {% endif %}
        <div class="werk-detail-meta">
          {%- comment -%}
            Link naar de regiopagina als die bestaat. Voorheen liep de relatie
            maar één kant op: regio's haalden projecten binnen via location,
            maar geen enkel project linkte terug.
          {%- endcomment -%}
          {% assign regio_match = site.regio | where: 'name', page.location | first %}
          <span>
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            {% if regio_match %}
              <a href="{{ regio_match.url | relative_url }}">{{ page.location }}</a>
            {% else %}
              {{ page.location }}
            {% endif %}
          </span>
          {% for cat in page.categories %}
            {% assign dienst_match = site.diensten | where_exp: 'd', 'd.category == cat' | first %}
            <span>
              <i class="fa-solid fa-tag" aria-hidden="true"></i>
              {% if dienst_match %}
                <a href="{{ dienst_match.url | relative_url }}">{{ cat }}</a>
              {% else %}
                {{ cat }}
              {% endif %}
            </span>
          {% endfor %}
        </div>
        <div class="werk-detail-intro">
          <p>{{ page.description }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% if content != '' %}
  <section class="werk-detail-story">
    <div class="container">
      <div class="row">
        <div class="col-lg-8">
          <div class="werk-detail-content">
            {{ content }}
          </div>
          <a href="{{ '/contact/' | relative_url }}" class="btn btn-green">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i> Vraag een offerte aan
          </a>
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% include cta-banner.liquid %}

<section id="section-related-artikels" class="fade-in-up">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <h2>Tips &amp; advies</h2>
      </div>
    </div>
    <div class="row">
      {% assign artikels = site.artikels | sort: 'date' | reverse %}
      {% for artikel in artikels limit: 3 %}
        <div class="col-md-4 mb-3">
          <h3>
            <a href="{{ artikel.url | relative_url }}">{{ artikel.header }}</a>
          </h3>
          <p>{{ artikel.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% include latest_werk.liquid limit_items="4" %}
