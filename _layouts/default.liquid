---
layout: compress
---
<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}
    <main id="content">
      {{ content }}
    </main>
    {%- comment -%}
      Het contactformulier stond op élke pagina. Dat verdubbelde de HTML en gaf
      op een werkpagina acht CTA's onder elkaar. Nu alleen waar het hoort; de
      andere pagina's sturen via de cta-banner naar /contact/.
    {%- endcomment -%}
    {% if page.url == '/contact/' %}
      {% include contact.liquid %}
    {% endif %}

    {% include mobile-cta.liquid %}

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    <script src="{{ '/assets/js/nav.js' | relative_url | bust_file_cache }}" defer></script>
    <!--
      Analytics: uitsluitend na toestemming. cookie-consent.liquid laadt
      _includes/ga.js pas nadat de bezoeker de cookiebanner aanvaardt.
    -->
    <script src="{{ '/assets/js/animations.js' | relative_url | bust_file_cache }}" defer></script>
    {% if page.url == '/werk/' %}
      <script src="{{ '/assets/js/werk-filter.js' | relative_url | bust_file_cache }}" defer></script>
    {% endif %}
    {% include cookie-consent.liquid %}
  </body>
</html>
