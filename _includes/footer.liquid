<footer class="sticky-bottom">
  <div class="container">
    <div class="row">
      <div class="col-sm-12 col-md-6 col-lg-3 mb-5">
        <h3 class="text-white">{{ site.footer_text }}</h3>
        BTW BE 0744.429.468
        <ul class="list-unstyled mt-3">
          <li><a href="{{ '/werkwijze/' | relative_url }}" class="link-white">Onze werkwijze</a></li>
          <li><a href="{{ '/faq/' | relative_url }}" class="link-white">Veelgestelde vragen</a></li>
          <li><a href="{{ '/diensten/' | relative_url }}" class="link-white">Onze diensten</a></li>
        </ul>
      </div>
      <div class="col-sm-12 col-md-6 col-lg-3 mb-5">
        <h3 class="text-white">Ons werk in regio</h3>
        {% assign regio_sorted = site.regio %}
        <ul class="list-unstyled">
          {% for regio in regio_sorted limit: 10 %}
            <li>
              <a href="{{regio.url}}" class="link-white">{{ regio.name }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="col-sm-12 col-md-6 col-lg-3 mb-5">
        <h3 class="text-white">Tips &amp; advies</h3>
        {% assign artikels_sorted = site.artikels %}
        <ul class="list-unstyled">
          {% for artikel in artikels_sorted limit: 5 %}
            <li>
              <a href="{{artikel.url}}" class="link-white">{{ artikel.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="col-sm-12 col-md-6 col-lg-3 mb-5">
        <h3 class="text-white">Adresgegevens</h3>
        <div>
          Bredepleinstraat 59 <br>
          3190 Boortmeerbeek
        </div>
        <br>
        <h3 class="text-white">Contactgegevens</h3>
        <div><a href="mailto:info@schrijnwerkerijtobback.be" class="link-white">info@schrijnwerkerijtobback.be</a></div>
        <div><a href="tel:+32496156640" class="link-white">0496 15 66 40</a></div>
        <br>
        <h3 class="text-white">Openingsuren</h3>
        <div>
          Ma - Vr: 7:00 - 20:00<br>
          Za: 8:00 - 20:00
        </div>
        <br>
        <h3 class="text-white">Volg ons</h3>
        <div>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 320 512"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/>
          </svg>
          <a href="https://www.facebook.com/profile.php?id=61555452444146" target="_blank" class="link-white">Facebook </a>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col mb-5">
        <a href="{{ '/privacy/' | relative_url }}" class="link-white">Privacy</a> | &copy; Copyright {{ site.time | date: '%Y' }}
        {{ site.title }}
      </div>
    </div>
  </div>
</footer>
