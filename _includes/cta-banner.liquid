      <a href="{{ '/contact/' | relative_url }}" class="btn btn-light btn-cta-primary">Vraag een vrijblijvende offerte</a>
      <a href="tel:+32496156640" class="btn btn-outline-light"> <i class="fa-solid fa-phone" aria-hidden="true"></i> Of bel 0496 15 66 40 </a>
    </div>
  </div>
</section>
